# Copy to .env and adjust. Never commit .env.

# --- Flask ---
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25

# --- Storage (relative paths resolve against backend/) ---
DATA_DIR=data
DATABASE_URL=sqlite:///data/rag.db

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
# "sentence-transformers" (real model) or "mock" (deterministic hashing, offline/testing)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_BATCH_SIZE=32

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=100

# --- Retrieval ---
TOP_K=5
SIMILARITY_THRESHOLD=0.25
# semantic | bm25 | hybrid
RETRIEVAL_METHOD=semantic
# Reranking backend: "lexical" (no model) or "cross-encoder" (downloads RERANKER_MODEL on first use)
RERANKER_BACKEND=lexical
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
# "ollama" or "mock"
LLM_BACKEND=ollama
